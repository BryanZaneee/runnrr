# --- LLM provider keys (at least one required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Tool keys (optional) ---
# Required for the web_search tool. Free tier: 1000 searches/month at tavily.com.
TAVILY_API_KEY=

# --- Optional RAG embeddings ---
# semantic_search_kb uses a prebuilt profile index. Use `fake` only for local
# smoke tests; live profiles should use `voyage` or `local`.
EASYAGENT_EMBEDDING_BACKEND=voyage
EASYAGENT_EMBEDDING_MODEL=
VOYAGE_API_KEY=
# Index build batch size for Voyage embed API. Free tier (no card): use 8.
EASYAGENT_EMBED_BATCH_SIZE=96
EASYAGENT_RAG_INDEX_ROOT=
ENABLE_EVALS_API=0   # set 1 locally to expose read-only /api/evals/* for web/evals/ dashboard (keep 0 in prod)
EASYAGENT_GRADER_MODEL=claude-haiku-4-5   # MODEL_REGISTRY id used by LLM eval graders + optional reranker
EASYAGENT_RERANK=0   # set 1 to enable Haiku reranking inside semantic_search_kb (needs ANTHROPIC_API_KEY)

# --- App config ---
# EasyAgent reads its KB and profiles from these roots. The bundled
# `personal-agent` example profile is the default. Set
# DEFAULT_PROFILE=customer-service to use the bundled small-business demo
# profile (Lantern Lane Coffee) instead.
EASYAGENT_KB_ROOT=./kb
EASYAGENT_PROFILE_ROOT=./profiles
DEFAULT_PROFILE=personal-agent
DEFAULT_MODEL=deepseek-v4-flash

# --- Limits ---
DAILY_TOKEN_BUDGET=5000000
SESSION_TTL_SECONDS=1800
MAX_TURNS_PER_SESSION=40
MAX_TOOL_HOPS=8
MAX_ACTIVE_SESSIONS=200
# Per-read inactivity timeout for provider SDK clients (seconds).
PROVIDER_TIMEOUT_SECONDS=120

# --- Abuse protection ---
RATE_LIMIT_CHAT=10/minute;100/hour
RATE_LIMIT_ENABLED=1
LOG_LEVEL=INFO

# --- CORS (dev) ---
ALLOWED_ORIGINS=http://localhost:8000

# --- Supabase (SaaS control plane; optional — public chat works without these) ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=
SUPABASE_ANON_KEY=
